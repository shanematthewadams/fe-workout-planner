    "catalog:export-sql": "node --experimental-strip-types scripts/export-regional-sql.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@eslint/js": "9.36.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "globals": "16.4.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "5.0.5"
